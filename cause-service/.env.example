# Copy to .env (git-ignored) and fill in.
# Password of degoog's settings page (required: without it anyone could install extensions).
DEGOOG_SETTINGS_PASSWORDS=change-me-to-a-long-random-password
# degoog API key, if you turn on API protection in degoog (Settings > Server > API Key).
DEGOOG_API_KEY=
# Comma-separated degoog engine ids to ask; empty = every enabled engine.
DEGOOG_ENGINES=
# Languages LibreTranslate downloads (en is required).
LT_LANGUAGES=en,ro,hu,es,pt,fr,de,it,pl,el,tr,ru,uk,bg
# Tile server folder with fire_pixels_<year>.csv (the same server and folder as the map tiles,
# e.g. http://<server-ip>:8080/tiles). Each year is downloaded once and kept in cache/.
# Empty: use local pixel files below, or the local fire_clusters files if none exist.
FIRE_DATA_URL=
# Local all-country pixel files, used when FIRE_DATA_URL is empty and files exist here.
FIRE_PIXELS_DIR=../harmonized
# Where fire_calendar.py wrote the fire_clusters_<year>_<Country>.csv files (when FIRE_DATA_URL is empty).
FIRE_CLUSTERS_DIR=../new_outputs/fire_clusters
CAUSE_PORT=8090
CAUSE_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
